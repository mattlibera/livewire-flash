{
    "name": "mattlibera/livewire-flash",
    "description": "Flash notifications using Livewire",
    "license": "MIT",
    "authors": [
        {
            "name": "Matt Libera",
            "email": "me@mattlibera.com"
        }
    ],
    "require": {
        "php": ">=8.0.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "livewire/livewire": "^2.12.7|^3.6.4"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MattLibera\\LivewireFlash\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MattLibera\\LivewireFlash\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "MattLibera\\LivewireFlash\\LivewireFlashServiceProvider"
            ],
            "aliases": {
                "LivewireFlash": "MattLibera\\LivewireFlash\\LivewireFlash"
            }
        }
    }
}
